# Demo is the default. No network requests are made in demo mode.
VITE_ASSESSMENT_MODE=demo
# Public backend URL, used only when mode is explicitly set to live.
VITE_API_BASE_URL=http://localhost:8000
# All VITE_ variables are public. Never put secrets or API keys here.
# Vercel Production: use live and your exact HTTPS Render URL after backend verification.
# Vercel Preview: keep demo unless that preview origin has an explicit backend allowlist entry.
# Changing VITE_ values requires a new frontend build/deployment.
