# Paths are resolved relative to the backend working directory.
WELLNESS_MODEL_PATH=models/model.joblib
WELLNESS_METADATA_PATH=models/metadata.json
# JSON array of exact frontend origins. No wildcard or credentialed CORS.
WELLNESS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Render: replace local origins with ["https://YOUR-PROJECT.vercel.app"] (no trailing slash).
# Do not allow *.vercel.app or all origins. Preview deployments should normally remain demo.
# Process environment is authoritative; this file is not automatically loaded.
